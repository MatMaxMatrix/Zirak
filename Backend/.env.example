# ─── LLM Provider Keys ────────────────────────────────────────────────────────
# Set at least one of OpenAI or DeepSeek (OpenAI is the default active provider).
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here    # optional – only if using Claude
DEEPSEEK_API_KEY=your_deepseek_api_key_here      # optional – switch in config.py

# ─── MCP Server ───────────────────────────────────────────────────────────────
# URL of the MCP tool server.  Change this if you run mcp_server.py on a
# different host or port.
MCP_SERVER_URL=http://localhost:3002/sse

# ─── Flask / Server ───────────────────────────────────────────────────────────
PORT=5001
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use * only during local development.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Optional Integrations ────────────────────────────────────────────────────
E2B_API_KEY=your_e2b_api_key     # code execution sandbox – optional

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
